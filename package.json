{
  "name": "study-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "start": "node --import tsx src/cli.ts",
    "serve": "node --import tsx src/server.ts",
    "dev": "concurrently -n backend,frontend,browser -c cyan,magenta,blue --kill-others-on-fail \"npm run serve\" \"npm --prefix web run dev\" \"sleep 3 && open http://localhost:3000\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@hono/node-server": "^2.0.12",
    "dotenv": "^16.4.5",
    "hono": "^4.12.33",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.15.0",
    "concurrently": "^10.0.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
